{
	"name": "seosonar",
	"main": "src/worker.js",
	"compatibility_date": "2024-10-01",
	"routes": [
		{
			"pattern": "seosonar.rayane.top",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "SEOSONAR_KV",
			"id": "9bfc3803c1e240c39e4d759985fe0e96",
			"remote": true
		}
	],
	"vars": {
		"DEFAULT_SCAN_TIMEOUT_MS": "12000"
	}
}